
name: My First Workflow

on:
  push:
    branches:
      - main

jobs:
  first-job:
    runs-on: ubuntu-latest

    steps:
      - name: Say Hello
        run: echo "Hello from GitHub Actions"

      - name: Show current directory
        run: pwd

      - name: Show files
        run: ls -la

      - name: Show Git version
        run: git --version
